{
  "name": "exlab_radio",
  "version": "1.0.0",
  "description": "Music streaming software for Georgia State University EXLAB organization",
  "homepage": "https://github.com/McDiamund/exlab_radio#readme",
  "bugs": {
    "url": "https://github.com/McDiamund/exlab_radio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McDiamund/exlab_radio.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite\" \"tsc --project tsconfig.json --watch\" \"nodemon --watch dist/main --ext js --exec cross-env NODE_ENV=development electron .\"",
    "build:main": "tsc --project tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build:main && electron ."
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
